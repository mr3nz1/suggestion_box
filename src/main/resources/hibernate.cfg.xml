<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- Defaults; overridden at runtime by DB_URL / DB_USER / DB_PASSWORD env vars -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/suggestionbox</property>
        <property name="hibernate.connection.username">suggestion</property>
        <property name="hibernate.connection.password">suggestion</property>

        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.connection.pool_size">10</property>
        <property name="hibernate.current_session_context_class">thread</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <mapping resource="rw/ac/suggestionbox/model/Category.hbm.xml"/>
        <mapping resource="rw/ac/suggestionbox/model/Suggestion.hbm.xml"/>

    </session-factory>
</hibernate-configuration>
