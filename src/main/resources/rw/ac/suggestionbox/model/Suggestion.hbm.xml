<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="rw.ac.suggestionbox.model">

    <class name="Suggestion" table="suggestions">
        <id name="id" column="id" type="long">
            <generator class="identity"/>
        </id>
        <property name="title" column="title" type="string" length="120" not-null="true"/>
        <property name="body" column="body" type="string" length="1000" not-null="true"/>
        <property name="submitterEmail" column="submitter_email" type="string" length="120" not-null="true"/>
        <property name="status" column="status" type="string" length="20" not-null="true"/>
        <property name="createdAt" column="created_at" type="java.time.LocalDateTime" not-null="true"/>

        <many-to-one name="category"
                     class="Category"
                     column="category_id"
                     not-null="true"
                     lazy="false"/>
    </class>

</hibernate-mapping>
